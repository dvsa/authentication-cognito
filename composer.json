{
  "name": "dvsa/authentication-cognito",
  "type": "library",
  "description": "A wrapper around the AWS SDK (Cognito)",
  "keywords": ["dvsa", "authentication", "cognito"],
  "license": "MIT",
  "authors": [
    {
      "name": "DVSA",
      "homepage": "https://www.gov.uk/government/organisations/driver-and-vehicle-standards-agency"
    }
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
    "ext-json": "*",
    "ext-openssl": "*",
    "aws/aws-sdk-php": "^3.383",
    "dvsa/contracts": "^1.3",
    "firebase/php-jwt": "^7.0",
    "guzzlehttp/guzzle": "^7.15.3",
    "guzzlehttp/psr7": "^2.13",
    "league/oauth2-client": "^2.9",
    "psr/cache": "^1.0 || ^2.0 || ^3.0",
    "psr/http-client": "^1.0.3",
    "psr/http-factory": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Dvsa\\Authentication\\Cognito\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dvsa\\Authentication\\Cognito\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.4",
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra" : {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": true
    }
  }
}
